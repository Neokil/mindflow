{
  "name": "mindflow-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-pdf-assets.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check src e2e scripts *.ts *.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "html2canvas": "1.4.1",
    "konva": "10.3.0",
    "lucide-react": "0.577.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.2",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "11.0.8"
  }
}
