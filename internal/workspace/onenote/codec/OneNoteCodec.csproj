<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <IlcPackageVersion>10.0.15</IlcPackageVersion>
    <AssemblyName>mindflow-onenote</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="OfficeIMO.OneNote" Version="3.6.0" /></ItemGroup>
</Project>
